# VEBOOK — ambiente local
# O protótipo atual usa dados mock em src/data/.
# Estas variáveis ficam reservadas para as próximas etapas (API, auth, analytics).

VITE_APP_NAME=VEBOOK
VITE_APP_URL=http://localhost:3000

# Pagamento: nenhum gateway real está configurado.
# mock = checkout simulado + webhook de teste (ambiente de demonstração).
# unset = arquitetura pronta, sem confirmação automática.
VITE_PAYMENTS_GATEWAY=mock

